# ---------------------------------------------------------------------------
# Routely API - environment template
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (credentials live only here, never in git)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=routely

# Base URL of the Next.js client that hosts the Better Auth endpoints.
# The API validates JWTs against `${AUTH_BASE_URL}/api/auth/jwks`.
AUTH_BASE_URL=http://localhost:3000

# Optional. Only needed if the client signs JWTs with HS256 instead of RS256.
# Leave empty when using the Better Auth JWKS endpoint.
AUTH_SECRET=

# Comma separated list of origins allowed to call this API.
# Vercel preview deployments are allowed automatically.
CLIENT_URLS=http://localhost:3000

# --- Payments -------------------------------------------------------------
# "stripe" = real Stripe Checkout. "mock" = local test mode (no keys needed).
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=bdt
PAYMENT_SUCCESS_URL=http://localhost:3000/dashboard/user-dashboard/bookings?payment=success
PAYMENT_CANCEL_URL=http://localhost:3000/dashboard/user-dashboard/bookings?payment=cancelled

# --- Image hosting --------------------------------------------------------
# When empty, /uploads/image returns 503 and the client falls back to a URL input.
IMGBB_API_KEY=
